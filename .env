# Database
DATABASE_URL=postgresql+asyncpg://elevator_user:elevator_pass@localhost:5432/elevator_ai
DATABASE_URL_SYNC=postgresql://elevator_user:elevator_pass@localhost:5432/elevator_ai

# JWT
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Elevator AI
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# First admin user (seeded on first run)
ADMIN_EMAIL=mohan@elevatorai.io
ADMIN_PASSWORD=change-this-password
